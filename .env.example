# =============================================================================
# SEO MASTER PRO - CONFIGURATION ENVIRONMENT
# =============================================================================
# Copy this file to .env and configure with your actual values
# All settings are optimized for production deployment
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
APP_NAME="SEO Master Pro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seo-master-pro.com
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seo_master_pro
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Optional: Read Replicas for scaling
DB_READ_HOST=127.0.0.1
DB_WRITE_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# CACHE & SESSION CONFIGURATION
# -----------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.seo-master-pro.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=seo_

# -----------------------------------------------------------------------------
# QUEUE CONFIGURATION
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# Horizon Configuration
HORIZON_BALANCE=auto
HORIZON_MIN_PROCESSES=1
HORIZON_MAX_PROCESSES=10
HORIZON_MEMORY_LIMIT=128

# -----------------------------------------------------------------------------
# MAIL CONFIGURATION
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@seo-master-pro.com"
MAIL_FROM_NAME="${APP_NAME}"

# Alternative: Amazon SES
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_SES_REGION=eu-west-1

# Alternative: Mailgun
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.eu.mailgun.net

# Alternative: Postmark
# MAIL_MAILER=postmark
# POSTMARK_TOKEN=

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_SLACK_WEBHOOK_URL=

# Custom Channels
LOG_API_CHANNEL=api
LOG_SECURITY_CHANNEL=security
LOG_PERFORMANCE_CHANNEL=performance

# -----------------------------------------------------------------------------
# BROADCASTING (WebSockets)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_SCHEME=https
PUSHER_HOST=
PUSHER_PORT=443

# Alternative: Laravel WebSockets
# BROADCAST_CONNECTION=redis
# LARAVEL_WEBSOCKETS_HOST=0.0.0.0
# LARAVEL_WEBSOCKETS_PORT=6001

# -----------------------------------------------------------------------------
# FILESYSTEM & STORAGE
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
FILESYSTEM_DRIVER=local

# Amazon S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# DigitalOcean Spaces
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=

# -----------------------------------------------------------------------------
# API INTEGRATIONS - SEO TOOLS
# -----------------------------------------------------------------------------

# Google Search Console API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_API_KEY=

# Google Analytics 4
GOOGLE_ANALYTICS_PROPERTY_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Ahrefs API (for backlinks analysis)
AHREFS_API_KEY=
AHREFS_API_TOKEN=
AHREFS_API_URL=https://apiv2.ahrefs.com

# Moz API (for domain authority)
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=

# Majestic SEO
MAJESTIC_API_KEY=

# SEMrush API (for competitor analysis)
SEMRUSH_API_KEY=
SEMRUSH_API_URL=https://api.semrush.com

# Serpstack API (for SERP tracking)
SERPSTACK_API_KEY=
SERPSTACK_HTTPS=true

# ScreamingFrog SEO Spider (optional)
SCREAMINGFROG_LICENSE_KEY=

# -----------------------------------------------------------------------------
# PAYMENT GATEWAYS
# -----------------------------------------------------------------------------

# Stripe Configuration
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Paddle Configuration (alternative)
PADDLE_VENDOR_ID=
PADDLE_VENDOR_AUTH_CODE=
PADDLE_PUBLIC_KEY=
PADDLE_SANDBOX=true

# PayPal Configuration (alternative)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SUBSCRIPTION PLANS CONFIGURATION
# -----------------------------------------------------------------------------
PLAN_FREE_PROJECTS=3
PLAN_FREE_KEYWORDS=10
PLAN_FREE_REPORTS=1

PLAN_STARTER_PROJECTS=10
PLAN_STARTER_KEYWORDS=100
PLAN_STARTER_REPORTS=10
PLAN_STARTER_PRICE=29.99

PLAN_PRO_PROJECTS=50
PLAN_PRO_KEYWORDS=1000
PLAN_PRO_REPORTS=100
PLAN_PRO_PRICE=99.99

PLAN_AGENCY_PROJECTS=200
PLAN_AGENCY_KEYWORDS=10000
PLAN_AGENCY_REPORTS=1000
PLAN_AGENCY_PRICE=299.99

PLAN_ENTERPRISE_PROJECTS=999999
PLAN_ENTERPRISE_KEYWORDS=999999
PLAN_ENTERPRISE_REPORTS=999999
PLAN_ENTERPRISE_PRICE=999.99

# -----------------------------------------------------------------------------
# API RATE LIMITING (requests per minute)
# -----------------------------------------------------------------------------
API_RATE_LIMIT_FREE=100
API_RATE_LIMIT_STARTER=500
API_RATE_LIMIT_PROFESSIONAL=2000
API_RATE_LIMIT_AGENCY=10000
API_RATE_LIMIT_ENTERPRISE=50000

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1,seo-master-pro.com,.seo-master-pro.com

# CORS Configuration
CORS_ALLOWED_ORIGINS="${APP_URL}"
CORS_ALLOWED_METHODS="GET,POST,PUT,DELETE,OPTIONS,PATCH"
CORS_ALLOWED_HEADERS="Content-Type,Authorization,X-Requested-With,Accept,Origin,X-CSRF-Token"
CORS_EXPOSED_HEADERS="X-Response-Time,X-RateLimit-Limit,X-RateLimit-Remaining"
CORS_MAX_AGE=3600
CORS_SUPPORTS_CREDENTIALS=true

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_REPORT_URI="${APP_URL}/csp-report"

# -----------------------------------------------------------------------------
# MONITORING & ANALYTICS
# -----------------------------------------------------------------------------

# Sentry Error Tracking
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# New Relic APM
NEWRELIC_LICENSE_KEY=
NEWRELIC_APP_NAME="${APP_NAME}"

# DataDog Monitoring
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.eu

# Google Tag Manager
GTM_CONTAINER_ID=

# -----------------------------------------------------------------------------
# CRAWLING & SCRAPING CONFIGURATION
# -----------------------------------------------------------------------------
CRAWLER_USER_AGENT="SEOMasterProBot/1.0 (+https://seo-master-pro.com/bot)"
CRAWLER_MAX_DEPTH=10
CRAWLER_MAX_PAGES=100000
CRAWLER_REQUESTS_PER_SECOND=5
CRAWLER_TIMEOUT=30
CRAWLER_MAX_REDIRECTS=5
CRAWLER_CONCURRENT_REQUESTS=10
CRAWLER_DELAY_BETWEEN_REQUESTS=1000
CRAWLER_RESPECT_ROBOTS_TXT=true

# Proxy Configuration (optional for crawling)
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# -----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=30
BACKUP_NOTIFICATION_EMAIL=admin@seo-master-pro.com

# -----------------------------------------------------------------------------
# WEBHOOK CONFIGURATION
# -----------------------------------------------------------------------------
WEBHOOK_ENABLED=true
WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT=10

# -----------------------------------------------------------------------------
# TWO-FACTOR AUTHENTICATION
# -----------------------------------------------------------------------------
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ISSUER="${APP_NAME}"

# -----------------------------------------------------------------------------
# SOCIAL AUTHENTICATION
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI="${APP_URL}/auth/twitter/callback"

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/auth/linkedin/callback"

# -----------------------------------------------------------------------------
# PERFORMANCE OPTIMIZATION
# -----------------------------------------------------------------------------
CACHE_TTL=3600
QUERY_CACHE_ENABLED=true
RESPONSE_CACHE_ENABLED=true
MINIFY_HTML=true
MINIFY_CSS=true
MINIFY_JS=true

# CDN Configuration
CDN_URL=
CDN_ENABLED=false

# -----------------------------------------------------------------------------
# MAINTENANCE MODE
# -----------------------------------------------------------------------------
MAINTENANCE_MODE=false
MAINTENANCE_SECRET=
MAINTENANCE_ALLOWED_IPS=

# -----------------------------------------------------------------------------
# DEVELOPMENT TOOLS (disable in production)
# -----------------------------------------------------------------------------
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
QUERY_DETECTOR_ENABLED=false

# -----------------------------------------------------------------------------
# CUSTOM APPLICATION SETTINGS
# -----------------------------------------------------------------------------
DEFAULT_CRAWL_DEPTH=3
DEFAULT_CRAWL_LIMIT=100
MAX_FILE_UPLOAD_SIZE=10240
REPORT_GENERATION_TIMEOUT=300
NOTIFICATION_THRESHOLD_RANKING_CHANGE=5
AUTO_CHECK_RANKINGS_INTERVAL=daily

# -----------------------------------------------------------------------------
# VITE CONFIGURATION
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
