APP_NAME="SEO Master Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seo_master_pro
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe Configuration
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Search Console API
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=

# Analytics API
GOOGLE_ANALYTICS_PROPERTY_ID=

# Proxy Configuration (for web scraping)
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Crawler Configuration
CRAWLER_USER_AGENT="SEOMasterProBot/1.0"
CRAWLER_MAX_DEPTH=10
CRAWLER_MAX_PAGES=100000
CRAWLER_REQUESTS_PER_SECOND=5

# External APIs
MAJESTIC_API_KEY=
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=
AHREFS_API_KEY=

# 2FA
TWO_FACTOR_ENABLED=true

# Rate Limiting
API_RATE_LIMIT_FREE=100
API_RATE_LIMIT_STARTER=500
API_RATE_LIMIT_PROFESSIONAL=2000
API_RATE_LIMIT_AGENCY=10000
API_RATE_LIMIT_ENTERPRISE=50000

VITE_APP_NAME="${APP_NAME}"
